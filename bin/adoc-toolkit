#!/bin/bash
# ADOC Toolkit launcher script for Unix systems (Linux/macOS)
# This script starts the ADOC interactive toolkit

set -e

# Change to the parent directory (project root)
cd "$(dirname "$0")/.."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}Error: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}$1${NC}"
}

print_info() {
    echo -e "${YELLOW}$1${NC}"
}

# Check if uv is available
if ! command -v uv &> /dev/null; then
    print_error "uv is not installed or not in PATH"
    echo "Please install uv: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

# Check if we're in the right directory (look for pyproject.toml)
if [[ ! -f "pyproject.toml" ]]; then
    print_error "pyproject.toml not found"
    echo "Please run this script from the adoc-toolkit root directory"
    exit 1
fi

# Install dependencies if needed
if [[ ! -d ".venv" ]]; then
    print_info "Installing dependencies..."
    if ! uv sync; then
        print_error "Failed to install dependencies"
        exit 1
    fi
    print_success "Dependencies installed successfully"
fi

# Start the ADOC toolkit
print_info "Starting ADOC Toolkit..."
uv run adoc-toolkit "$@"